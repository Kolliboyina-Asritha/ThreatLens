{
  "manifest_version": 3,
  "name": "ThreatLens AI — Smart Browser Protection",
  "version": "3.0.0",
  "description": "Explainable real-time browser protection against suspicious and malicious URLs using Heuristics, ML, Threat Intelligence, and User-Controlled Policies.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "https://*.threatlens.io/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ThreatLens AI Protection"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/warning.html",
        "pages/blocked.html",
        "shared/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
